# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Klaviyo ───────────────────────────────────────────────────────────────────
# From Klaviyo → Account → Settings → API Keys → Create Private API Key
KLAVIYO_PRIVATE_API_KEY=

# ── Podium SMS ────────────────────────────────────────────────────────────────
# From Podium developer portal
PODIUM_API_KEY=
PODIUM_LOCATION_ID=

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Google Sheet ID — from the URL: .../spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEETS_ID=
# Google service account credentials (from service account JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value exactly — include -----BEGIN PRIVATE KEY----- etc.
# In Vercel, paste as-is. Locally, wrap with quotes and use \n for newlines.
GOOGLE_PRIVATE_KEY=

# ── Google Maps (address autocomplete) ───────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable: Maps JavaScript API + Places API on the key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Store info (public) ───────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=Class A Jewellers
NEXT_PUBLIC_STORE_PHONE=+61883447722
NEXT_PUBLIC_STORE_EMAIL=customercare@classa.com.au
NEXT_PUBLIC_STORE_ADDRESS=40 North East Road, Walkerville SA 5081

# ── Dymo Connect ─────────────────────────────────────────────────────────────
# Set to the counter PC's local IP address so the iPad can reach it.
# e.g. 192.168.1.50  (find with ipconfig on the counter PC)
# Leave as "localhost" when testing on the same machine as Dymo Connect.
NEXT_PUBLIC_DYMO_SERVICE_HOST=localhost

# ── Zapier webhooks (SMS notifications via Podium) ───────────────────────────
ZAPIER_ORDER_CONFIRMATION_WEBHOOK=https://hooks.zapier.com/hooks/catch/16866217/4yds9xh/
ZAPIER_READY_FOR_PICKUP_WEBHOOK=https://hooks.zapier.com/hooks/catch/16866217/4y9iamy/

# ── Zapier webhooks (Email notifications via Podium) ─────────────────────────
ZAPIER_ORDER_CONFIRMATION_EMAIL_WEBHOOK=
ZAPIER_READY_FOR_PICKUP_EMAIL_WEBHOOK=

# ── Shopify ───────────────────────────────────────────────────────────────────
# Your Shopify store's myshopify.com domain (no https://)
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
# Admin API access token — from Shopify admin → Apps → Develop apps
# Required scopes: read_orders, read_customers
SHOPIFY_ADMIN_API_TOKEN=
# Webhook signing secret — shown once when you create the webhook in Shopify
# Settings → Notifications → Webhooks → (your webhook) → Signing secret
SHOPIFY_WEBHOOK_SECRET=
